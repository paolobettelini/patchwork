{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Patchwork",
  "version": "0.1.0",
  "identifier": "dev.patchwork.desktop",
  "build": {
    "beforeDevCommand": "cargo run --manifest-path tools/desktop-tool/Cargo.toml -- frontend-dev",
    "beforeBuildCommand": "cargo run --manifest-path tools/desktop-tool/Cargo.toml -- frontend-build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Patchwork",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../public/logo.png"]
  }
}
